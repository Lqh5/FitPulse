# FitPulse 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== Claude API ==========
ANTHROPIC_API_KEY=sk-ant-xxx

# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=fitpulse2024
MYSQL_DATABASE=fitpulse
MYSQL_USER=fitpulse
MYSQL_PASSWORD=fitpulse2024

# ========== Chroma Vector DB ==========
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ========== MinIO Object Storage ==========
